{
  "name": "ai-workbench",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "bridge:start": "node scripts/start-feishu-workbench-bridge.mjs",
    "bridge:runtime": "node scripts/workbench-agent-runtime.mjs",
    "bridge:feishu": "node scripts/workbench-feishu-adapter.mjs",
    "api": "node server.mjs",
    "build": "vite build",
    "build:icon": "node scripts/generate-icon.mjs",
    "electron": "npm run build && npm run build:icon && electron .",
    "dist:win": "node scripts/clean-release-output.mjs && npm run build && npm run build:icon && electron-builder --win nsis --publish never",
    "preview": "vite preview",
    "verify": "node scripts/verify-mandatory-gates-001.mjs",
    "verify:product": "node scripts/verify.mjs",
    "verify:checkpoint-protection": "node scripts/verify-checkpoint-protection-001.mjs",
    "verify:git-bypasses": "node scripts/scan-git-destructive-bypasses.mjs",
    "verify:execution-protocol": "node scripts/verify-execution-protocol-checkpoint.mjs",
    "checkpoint:focused": "node scripts/run-focused-checkpoint.mjs",
    "git:guarded-restore": "node scripts/git-guard.mjs restore",
    "verify:agents": "node scripts/verify-agents.mjs",
    "verify:tasks-runs": "node scripts/verify-tasks-runs.mjs",
    "verify:memories": "node scripts/verify-memories.mjs",
    "verify:hermes": "node scripts/verify-hermes-adapter.mjs",
    "verify:verification": "node scripts/verify-verification-layer.mjs",
    "verify:errors": "node scripts/verify-error-normalization.mjs",
    "verify:health": "node scripts/verify-health-self-heal.mjs",
    "verify:model-proxy": "node scripts/verify-model-proxy.mjs",
    "verify:unified-model-proxy": "node scripts/verify-unified-model-proxy.mjs",
    "verify:clean-machine": "node scripts/verify-clean-machine.mjs",
    "verify:shared-key": "node scripts/verify-shared-key.mjs",
    "verify:install-release": "node scripts/verify-install-release.mjs",
    "verify:3a-final": "node --use-env-proxy scripts/verify-3a-final.mjs",
    "verify:managed-proxy-production": "node --use-env-proxy scripts/verify-managed-proxy-production.mjs",
    "verify:chat-proxy": "node scripts/verify-chat-proxy.mjs",
    "verify:hermes-proxy": "node scripts/verify-hermes-proxy.mjs",
    "verify:acceptance": "node scripts/verify-acceptance.mjs",
    "verify:action-routing": "node scripts/verify-action-routing.mjs",
    "verify:versions": "node scripts/verify-version-management.mjs",
    "capture:strict-acceptance": "node scripts/capture-strict-acceptance.mjs",
    "capture:v041-installed": "node scripts/capture-v041-installed.mjs",
    "versions:snapshot": "node scripts/versions-snapshot.mjs",
    "versions:doctor": "node scripts/versions-doctor.mjs",
    "versions:restore": "node scripts/versions-restore.mjs",
    "versions:check-models": "node scripts/versions-check-models.mjs",
    "openclaw:gateway-diagnostics": "node scripts/openclaw-gateway-diagnostics.mjs",
    "openclaw:candidate-diagnostics": "node scripts/openclaw-candidate-diagnostics.mjs",
    "openclaw:runtime-inventory": "node scripts/openclaw-runtime-inventory.mjs",
    "openclaw:runtime-deep-dive": "node scripts/openclaw-runtime-deep-dive.mjs",
    "health:check": "node scripts/health-check.mjs",
    "health:repair": "node scripts/health-repair.mjs",
    "task-gateway": "node scripts/task-gateway.mjs",
    "verify:task-gateway": "node scripts/verify-task-gateway.mjs",
    "feishu-channel:start": "node scripts/feishu-task-channel.mjs start",
    "feishu-channel:check": "node scripts/feishu-task-channel.mjs check",
    "verify:feishu-channel": "node scripts/verify-feishu-task-channel.mjs",
    "docs:generate-handoff": "node scripts/generate-handoff.mjs",
    "verify:docs-consistency": "node scripts/verify-docs-consistency.mjs",
    "verify:authoritative-index": "node scripts/verify-authoritative-index-consistency-001.mjs --json",
    "test:authoritative-index-validator": "node --test tests/verify-authoritative-index-consistency-001.test.mjs",
    "exec:preflight": "node scripts/exec-guard.mjs preflight",
    "exec:postcommit": "node scripts/exec-guard.mjs postcommit",
    "exec:report": "node scripts/exec-guard.mjs report",
    "test:exec-guard": "node --test tests/exec-guard.test.mjs",
    "verify:step6-contract": "node scripts/verify-step6-legacy-run-api-contract-001.mjs",
    "verify:step6-legacy-run-api-archive": "node scripts/verify-legacy-run-api-archive-completeness-001.mjs",
    "test:step6-contract-validator": "node --test tests/verify-step6-legacy-run-api-contract-001.test.mjs",
    "verify:step7-contract": "node scripts/verify-step7-mandatory-gates-contract-001.mjs",
    "test:step7-contract-validator": "node --test tests/verify-step7-mandatory-gates-contract-001.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aiworkbench.desktop",
    "productName": "AI Workbench",
    "asar": true,
    "directories": {
      "output": "release-v0.4.6-installer"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.ico",
      "server.mjs",
      "model-proxy.mjs",
      "runtime-paths.mjs",
      "readiness.mjs",
      "package.json",
      "agents/**",
      "errors/**",
      "health/**",
      "versions/**",
      "verification/rules.mjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "AI-Workbench-Setup-v${version}-${arch}.exe",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Workbench",
      "deleteAppDataOnUninstall": false
    }
  }
}
