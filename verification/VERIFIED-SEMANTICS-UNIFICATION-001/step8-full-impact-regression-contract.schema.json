{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-workbench.step8-full-impact-regression-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "contractStatus",
    "baselineHead",
    "step8FormalName",
    "step8Purpose",
    "authoritySources",
    "step8EntryConditions",
    "step8RequiredRegression",
    "step8RequiredAttackMatrix",
    "step8RequiredMandatoryGates",
    "step8EvidenceRequirements",
    "fourthRiskScope",
    "fourthRiskOpenState",
    "fourthRiskClosedState",
    "fourthRiskCloseConditions",
    "finalAcceptanceRelationship",
    "deploymentRelationship",
    "productLandingBlockers",
    "prohibitedProductChanges",
    "validators",
    "checkpointTopology",
    "successState",
    "currentStateAfterEnablement"
  ],
  "properties": {
    "schemaVersion": {"const": "ai-workbench.step8-full-impact-regression-contract/v1"},
    "contractId": {"const": "STEP8-FULL-IMPACT-REGRESSION-MACHINE-CONTRACT-001"},
    "contractStatus": {"const": "ENABLED_FOR_PACKAGE_A"},
    "baselineHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "step8FormalName": {"const": "LEGACY-RUN-API-STEP8-FULL-IMPACT-REGRESSION-AND-FOURTH-RISK-CLOSEOUT-001"},
    "step8Purpose": {"type": "string", "minLength": 1},
    "authoritySources": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "step8EntryConditions": {"type": "object"},
    "step8RequiredRegression": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "object"}},
    "step8RequiredAttackMatrix": {"type": "array", "minItems": 14, "uniqueItems": true, "items": {"type": "object"}},
    "step8RequiredMandatoryGates": {"type": "object"},
    "step8EvidenceRequirements": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "fourthRiskScope": {"type": "object"},
    "fourthRiskOpenState": {"const": "OPEN"},
    "fourthRiskClosedState": {"const": "RESOLVED"},
    "fourthRiskCloseConditions": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "finalAcceptanceRelationship": {"type": "object"},
    "deploymentRelationship": {"type": "object"},
    "productLandingBlockers": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "object"}},
    "prohibitedProductChanges": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "validators": {"type": "object"},
    "checkpointTopology": {"type": "object"},
    "successState": {"type": "object"},
    "currentStateAfterEnablement": {"type": "object"}
  }
}
